        "/api/v1/education/countries": {
            "get": {
                "description": "Get all countries ordered by name",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "education"
                ],
                "summary": "List countries",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.CountryListResponse"
