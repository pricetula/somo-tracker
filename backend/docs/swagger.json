    "definitions": {
        "handler.ChallengeRequest": {
            "type": "object",
            "required": [
                "action",
                "client_subnet",
                "email_hash"
            ],
            "properties": {
                "action": {
                    "type": "string",
                    "enum": [
                        "otp_request",
                        "onboard"
                    ]
                },
                "client_subnet": {
                    "type": "string"
                },
                "email_hash": {
                    "type": "string"
                }
            }
        },
        "handler.ChallengeResponse": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string"
                },
                "challenge_id": {
                    "type": "string"
                },
                "difficulty": {
                    "type": "integer"
                },
                "expires_at": {
                    "type": "string"
                },
                "seed": {
                    "type": "string"
                },
                "site_key": {
                    "type": "string"
                },
                "type": {
                    "description": "\"pow\" | \"turnstile\"",
                    "type": "string"
                }
            }
        },
        "handler.OnboardRequest": {
            "type": "object",
            "required": [
                "organization_name",
                "school_name",
                "user_name"
            ],
            "properties": {
                "organization_name": {
                    "type": "string"
                },
                "pow_solution": {
                    "$ref": "#/definitions/handler.PowSolution"
                },
                "school_name": {
                    "type": "string"
                },
                "user_name": {
                    "type": "string"
                }
            }
        },
        "handler.PowSolution": {
            "type": "object",
            "properties": {
                "challenge_id": {
                    "type": "string"
                },
                "nonce": {
                    "type": "string"
                }
            }
        },
        "handler.RequestOTPRequest": {
            "type": "object",
            "required": [
                "email",
                "turnstile_token"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "pow_solution": {
                    "$ref": "#/definitions/handler.PowSolution"
                },
                "turnstile_token": {
                    "type": "string"
                }
            }
        },
        "handler.RequestOTPResponse": {
            "type": "object",
            "properties": {
                "challenge_id": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "ok": {
                    "type": "boolean"
                }
            }
        },
        "handler.SessionResponse": {
            "type": "object",
            "properties": {
                "authenticated": {
                    "type": "boolean"
                },
                "needs_onboarding": {
                    "type": "boolean"
                },
                "ok": {
                    "type": "boolean"
                },
                "session_type": {
                    "type": "string"
                }
            }
        },
        "handler.VerifyOTPRequest": {
            "type": "object",
            "required": [
                "challenge_id",
                "code"
            ],
            "properties": {
                "challenge_id": {
                    "type": "string"
                },
                "code": {
                    "type": "string"
                }
