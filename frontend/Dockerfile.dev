FROM node:20-alpine

WORKDIR /app

# Install pnpm (pin to v12 to match pnpm-lock.yaml format)
RUN npm install -g pnpm@12

# Install dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Expose Next.js dev port
EXPOSE 3000

# Start dev server. HOSTNAME=0.0.0.0 is required so the dev server
# accepts connections from outside the container (docker port mapping).
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

CMD ["pnpm", "run", "dev"]
