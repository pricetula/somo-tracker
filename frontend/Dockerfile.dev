FROM node:20-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@12.11.2 --activate

# Install deps (cached layer)
COPY package.json pnpm-lock.yaml ./
RUN pnpm config set minimum-release-age 0 && pnpm approve-builds @parcel/watcher unrs-resolver && pnpm install --frozen-lockfile

# Vite dev server with HMR
EXPOSE 3000
CMD ["pnpm", "dev"]