FROM node:20-alpine

WORKDIR /app

# Install pnpm (pin to v12 to match pnpm-lock.yaml format)
RUN npm install -g pnpm@12

# Install dependencies
COPY package.json pnpm-lock.yaml ./
# pnpm 12 requires explicit approval for dependency build scripts
# (workerd, shipped by playwright). Approve once so the approval
# persists in the image for both build-time and runtime installs.
RUN pnpm approve-builds workerd -y
RUN pnpm install --frozen-lockfile

COPY . .

# Expose Next.js dev port
EXPOSE 3000

# Start dev server. HOSTNAME=0.0.0.0 is required so the dev server
# accepts connections from outside the container (docker port mapping).
# Install dependencies at runtime because the anonymous /app/node_modules
# volume shadows the image-installed node_modules.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm run dev"]
