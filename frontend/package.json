{
  "name": "somotracker-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "lint-staged": "pnpm lint:fix && pnpm format",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"deploy": "npm run build && wrangler deploy",
    "generate:api": "openapi-typescript ../docs/api/openapi.yaml -o ./src/features/auth/api/generated/types.ts"
  },
