<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Somotracker — Coming Soon</title>
    <meta name="description" content="Somotracker is coming soon. Fast, reliable attendance, assessment, welfare and fees for Kenyan schools." />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <nav class="fixed inset-0 z-50 flex items-center justify-between px-6 py-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary-500 rounded-lg flex items-center justify-center text-white font-bold text-lg">S</div>
        <span class="font-bold text-xl tracking-tight text-primary">Somotracker</span>
      </div>
      <button class="bg-primary-500 hover:bg-primary-600 text-white px-6 py-2 rounded-lg font-medium transition-colors shadow-lg shadow-primary-500/20">Join Waitlist</button>
    </nav>

    <main class="relative min-h-screen flex flex-col items-center justify-center pt-20 pb-12 px-6">
      <!-- Decorative background blobs -->
      <div class="absolute top-0 left-0 w-full h-full -z-10 opacity-15 pointer-events-none">
        <div class="absolute -top-1/4 -left-1/4 w-96 h-96 bg-primary-500/10 rounded-full blur-[120px]" style="animation: pulse-1 8s ease-in-out infinite;"></div>
        <div class="absolute -bottom-1/4 -right-1/4 w-96 h-96 bg-rose-500/10 rounded-full blur-[120px]" style="animation: pulse-2 10s ease-in-out infinite;"></div>
      </div>

      <div class="max-w-4xl text-center space-y-10">
        <!-- Hero -->
        <div class="flex flex-col items-center gap-4">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-500/10 border border-primary-500/20 text-primary-400 text-xs font-medium tracking-wider uppercase">Launching Q1 2027</span>
          
          <h1 class="text-5xl md:text-7xl font-bold text-primary tracking-tight leading-tight">Somotracker</h1>
          <p class="text-lg md:text-xl text-gray-400 max-w-xl mx-auto leading-relaxed">
            Fast, reliable attendance, assessment, welfare and fee management for Kenyan schools.
          </p>

          <!-- Countdown Timer -->
          <div class="flex flex-wrap justify-center gap-4 pt-8 border-t border-white/10">
            <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-primary-500/10 border border-primary-500/20">
              <span class="text-2xl font-bold text-white">00:00</span>
              <span class="text-xs text-primary">Days</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-primary-500/10 border border-primary-500/20">
              <span class="text-2xl font-bold text-white">00:00</span>
              <span class="text-xs text-primary">Hours</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-primary-500/10 border border-primary-500/20">
              <span class="text-2xl font-bold text-white">00:00</span>
              <span class="text-xs text-primary">Minutes</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-primary-500/10 border border-primary-500/20">
              <span class="text-2xl font-bold text-white">00:00</span>
              <span class="text-xs text-primary">Seconds</span>
            </div>
          </div>

          <!-- Email Signup -->
          <form class="mt-10 max-w-lg mx-auto w-full relative group">
            <div class="flex gap-3">
              <input 
                type="email" 
                placeholder="Enter your email address" 
                class="flex-1 bg-white/5 border border-white/10 rounded-xl px-6 py-4 text-primary placeholder-gray-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-all backdrop-blur-sm" 
                required
              />
              <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-xl font-semibold transition-all shadow-lg shadow-primary-500/30 group-hover:scale-105 active:scale-95">Get Early Access</button>
            </div>
            <p class="mt-4 text-xs text-gray-500 text-center">We'll notify you when Somotracker launches. No spam, ever.</p>
          </form>
        </div>

        <!-- Features Preview -->
        <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Feature 1 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-primary-500/30 transition-all group">
            <div class="w-12 h-12 bg-primary-500/10 rounded-lg flex items-center justify-center text-primary font-bold group-hover:bg-primary-500/20 transition-colors">📊</div>
            <h3 class="text-lg font-bold text-primary mb-2">Attendance Tracking</h3>
            <p class="text-gray-400">Real-time student attendance with customizable schedules and reporting.</p>
          </div>
          <!-- Feature 2 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-primary-500/30 transition-all group">
            <div class="w-12 h-12 bg-rose-500/10 rounded-lg flex items-center justify-center text-primary font-bold group-hover:bg-rose-500/20 transition-colors">📝</div>
            <h3 class="text-lg font-bold text-primary mb-2">Grade Management</h3>
            <p class="text-gray-400">Effortlessly manage grades, reports, and academic progress for each student.</p>
          </div>
          <!-- Feature 3 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-primary-500/30 transition-all group">
            <div class="w-12 h-12 bg-violet-500/10 rounded-lg flex items-center justify-center text-primary font-bold group-hover:bg-violet-500/20 transition-colors">📬</div>
            <h3 class="text-lg font-bold text-primary mb-2">Fee & Payment</h3>
            <p class="text-gray-400">Track fees, manage payments, and generate invoices with ease.</p>
          </div>
          <!-- Feature 4 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-primary-500/30 transition-all group">
            <div class="w-12 h-12 bg-amber-500/10 rounded-lg flex items-center justify-center text-primary font-bold group-hover:bg-amber-500/20 transition-colors">👨‍🏫</div>
            <h3 class="text-lg font-bold text-primary mb-2">Parent Communication</h3>
            <p class="text-gray-400">Stay connected with parents through notifications and messaging.</p>
          </div>
        </div>

        <!-- CTA Banner -->
        <div class="mt-16 bg-primary-500/10 border border-primary-500/20 rounded-2xl p-8 text-center">
          <h2 class="text-2xl font-bold text-white mb-4">Be the First to Know</h2>
          <p class="text-white/80 mb-6">Join our waitlist and get early access when Somotracker launches.</p>
          <button class="bg-white text-primary hover:bg-gray-200 font-semibold py-3 px-8 rounded-xl transition-all shadow-lg shadow-white/10">Join Waitlist</button>
        </div>
      </div>

      <!-- Footer -->
      <footer class="py-12 px-6 border-t border-white/5">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 bg-primary-500 rounded flex items-center justify-center text-white font-bold text-sm">S</div>
            <span class="font-bold text-white">Somotracker</span>
          </div>
          <p class="text-gray-500 text-sm">© 2026 Somotracker. All rights reserved.</p>
          <div class="flex gap-6 text-sm">
            <a href="#" class="text-gray-400 hover:text-primary transition-colors">Privacy</a>
            <a href="#" class="text-gray-400 hover:text-primary transition-colors">Terms</a>
            <a href="#" class="text-gray-400 hover:text-primary transition-colors">Contact</a>
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>
