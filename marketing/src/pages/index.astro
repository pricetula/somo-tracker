---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Somotracker">
  <main class="min-h-[100dvh] grid place-items-center px-6 bg-background text-foreground">
    <div class="text-center space-y-6">
      <div class="mx-auto w-12 h-12 rounded-xl bg-primary text-primary-foreground grid place-items-center font-bold text-xl">S</div>
      <div class="space-y-2">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Somotracker is building</h1>
        <p class="text-muted-foreground">Fast, reliable attendance and welfare for Kenyan schools.</p>
      </div>
    </div>
  </main>
</Layout>
