---
---
<section class="bg-surface" aria-label="Before and after">
  <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-ink mb-12">From scattered to simple</h2>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-line">
            <th class="py-3 pr-6 text-sm font-semibold text-ink uppercase tracking-wide">Today</th>
            <th class="py-3 pl-6 text-sm font-semibold text-ink uppercase tracking-wide">With Somotracker</th>
          </tr>
        </thead>
        <tbody class="text-body leading-relaxed">
          <tr class="border-b border-line">
            <td class="py-4 pr-6">Timetables in Word and Excel, redone every term</td>
            <td class="py-4 pl-6">One timetable per term you can edit and reuse</td>
          </tr>
          <tr class="border-b border-line">
            <td class="py-4 pr-6">Teacher absent, headteacher scrambling</td>
            <td class="py-4 pl-6">Substitution recorded and visible</td>
          </tr>
          <tr class="border-b border-line">
            <td class="py-4 pr-6">Paper registers</td>
            <td class="py-4 pl-6">Digital attendance by class</td>
          </tr>
          <tr>
            <td class="py-4 pr-6">Events and rooms tracked in WhatsApp groups</td>
            <td class="py-4 pl-6">One shared calendar</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
