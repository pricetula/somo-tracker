<section aria-label="Founder">
  <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
    <div class="flex flex-col md:flex-row items-start gap-6 md:gap-10">
      <figure class="shrink-0">
        <div class="w-20 h-20 md:w-24 md:h-24 rounded-full border-2 border-dashed border-line bg-surface flex items-center justify-center overflow-hidden" aria-label="Founder photo">
          <span class="text-xs font-medium text-muted">Founder photo</span>
          <!-- TODO: supply square monochrome portrait; image uses rounded-full -->
        </div>
      </figure>
      <div class="max-w-xl">
        <h2 class="text-xl font-semibold text-ink mb-1">[FOUNDER NAME]</h2>
        <p class="text-body leading-relaxed">[FOUNDER STORY: why you built this, in plain words.]</p>
        <p class="text-sm text-muted mt-3"><a href="https://wa.me/[WHATSAPP_NUMBER_INTERNATIONAL_FORMAT]" class="underline decoration-1 underline-offset-2 hover:text-ink" target="_blank" rel="noopener noreferrer">Optional WhatsApp link</a></p>
      </div>
    </div>
  </div>
</section>
