---
---
<section class="bg-white" aria-label="Hero">
  <div class="max-w-5xl mx-auto px-6 pt-16 md:pt-28 pb-10 md:pb-16">
    <div class="flex items-start gap-6 md:gap-10">
      <!-- Main content -->
      <div class="flex-1 min-w-0">
        <div class="inline-flex items-center gap-3 text-xs md:text-sm font-medium uppercase tracking-wide text-muted mb-6">
          <span>Term 1 2027 Pilot</span>
          <span aria-hidden="true" class="w-1 h-1 rounded-full bg-muted" />
          <span>Limited places</span>
          <span aria-hidden="true" class="w-1 h-1 rounded-full bg-muted" />
          <span>Apply by [DEADLINE]</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05] text-ink mb-6">Run your school's classes, timetable and attendance from one simple system.</h1>
        <p class="text-lg md:text-xl text-body leading-relaxed max-w-2xl mb-10">Somotracker is school management built in Nairobi for Kenyan schools, from PP1 to Junior Secondary. Join the Term 1 2027 pilot, use it free, and help shape what we build next, including CBC report cards.</p>

        <!-- Form -->
        <form id="pilot-form" action="[FORM_ENDPOINT]" method="POST" class="bg-surface border border-line rounded-2xl p-6 md:p-8 max-w-lg" novalidate>
          <div class="grid gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-ink mb-1.5">Your name</label>
              <input id="name" name="name" type="text" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition" placeholder="Your name" />
              <p id="name-error" class="text-sm text-ink mt-1 hidden">Please enter your name.</p>
            </div>
            <div>
              <label for="school" class="block text-sm font-medium text-ink mb-1.5">School name</label>
              <input id="school" name="school" type="text" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition" placeholder="School name" />
              <p id="school-error" class="text-sm text-ink mt-1 hidden">Please enter your school name.</p>
            </div>
            <div>
              <label for="whatsapp" class="block text-sm font-medium text-ink mb-1.5">WhatsApp number</label>
              <input id="whatsapp" name="whatsapp" type="tel" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition" placeholder="07XX XXX XXX" inputmode="numeric" />
              <p id="whatsapp-error" class="text-sm text-ink mt-1 hidden">Please enter a valid WhatsApp number.</p>
            </div>
            <div>
              <label for="role" class="block text-sm font-medium text-ink mb-1.5">Role</label>
              <select id="role" name="role" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition appearance-none">
                <option value="" disabled selected>Select your role</option>
                <option value="Headteacher">Headteacher</option>
                <option value="Deputy">Deputy headteacher</option>
                <option value="Bursar">Bursar</option>
                <option value="Owner">School owner</option>
                <option value="Other">Other</option>
              </select>
              <p id="role-error" class="text-sm text-ink mt-1 hidden">Please select your role.</p>
            </div>
            <div aria-hidden="true" class="hidden">
              <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
            </div>
          </div>
          <button type="submit" id="submit-btn" class="w-full md:w-auto mt-5 bg-ink text-white font-semibold rounded-lg px-6 py-4 text-base hover:bg-neutral-800 transition-colors min-h-[48px]">Join the pilot</button>
        </form>

        <div id="form-status" class="mt-4 text-sm" aria-live="polite"></div>
        <p class="text-sm text-muted mt-3">Free during the pilot. We'll WhatsApp you within 48 hours.</p>
        <p class="text-sm text-muted mt-2">Prefer to chat? <a href="https://wa.me/[WHATSAPP_NUMBER_INTERNATIONAL_FORMAT]?text=Hi%2C%20I'd%20like%20to%20join%20the%20Somotracker%20pilot." class="underline decoration-1 underline-offset-2 hover:text-ink" target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a></p>
      </div>

      <!-- Illustration slot (desktop only) -->
      <aside class="hidden lg:block w-72 shrink-0" aria-label="Illustration">
        <div class="border-2 border-dashed border-line bg-surface rounded-2xl aspect-[4/5] flex flex-col items-center justify-center gap-3 p-6 text-center">
          <span class="text-xs font-medium uppercase tracking-wide text-muted">Illustration</span>
          <span class="text-sm font-medium text-ink">Hero illustration (optional)</span>
          <!-- TODO: supply hand-drawn monochrome illustration -->
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  (function () {
    const form = document.getElementById('pilot-form') as HTMLFormElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !btn) return;

    form.addEventListener('submit', function (e) {
      // Basic validation
      const fields = ['name', 'school', 'whatsapp', 'role'];
      let valid = true;
      fields.forEach(function (id) {
        const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
        const err = document.getElementById(id + '-error');
        if (el && err) {
          if (!el.value.trim()) {
            err.classList.remove('hidden');
            valid = false;
          } else {
            err.classList.add('hidden');
          }
        }
      });
      if (!valid) {
        e.preventDefault();
        return;
      }

      // Honeypot
      const hp = form.querySelector('input[name="honeypot"]') as HTMLInputElement | null;
      if (hp && hp.value.trim() !== '') {
        e.preventDefault();
        return;
      }

      btn.textContent = 'Sending...';
      btn.disabled = true;
      btn.classList.add('opacity-70');

      // Progressive enhancement: if endpoint not set, show success for demo
      const endpoint = form.getAttribute('action');
      if (!endpoint || endpoint.startsWith('[')) {
        e.preventDefault();
        const nameEl = form.querySelector('#name') as HTMLInputElement | null;
        const first = nameEl?.value.trim().split(' ')[0] ?? '';
        form.innerHTML = '<div class="p-6"><p class="text-lg font-semibold text-ink">Karibu, ' + first + '. We\'ve got your details and will WhatsApp you within 48 hours.</p></div>';
        return;
      }
    });
  })();
</script>
