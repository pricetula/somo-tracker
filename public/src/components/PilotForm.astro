---
export interface Props {
  id?: string;
}
const { id = 'pilot-form' } = Astro.props;
---
<section id={id} class="bg-white" aria-label="Join the pilot">
  <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
    <div class="grid md:grid-cols-2 gap-10 md:gap-14">
      <div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-ink mb-3">Join the Term 1 2027 Pilot</h2>
        <p class="text-lg text-body leading-relaxed mb-6">We are onboarding [PILOT_SIZE] schools. You get:</p>
        <ul class="list-disc pl-5 text-body leading-relaxed mb-6 space-y-2">
          <li>Free access for the whole pilot term</li>
          <li>Help setting up your school structure</li>
          <li>A direct WhatsApp line to the founder</li>
          <li>A real say in what gets built next, especially report cards and fees</li>
        </ul>
        <p class="text-body leading-relaxed mb-10">Ask: Honest feedback, and about 30 minutes a week from one person at your school.</p>
        <p class="text-xs text-muted">Applications close [DEADLINE].</p>
        <p class="text-xs text-muted mt-2">After the pilot: [POST_PILOT_PRICING_LINE] (Omit this line if pricing is undecided.)</p>
      </div>
      <div>
        <form id={id + '-form'} data-form-id={id} action="[FORM_ENDPOINT]" method="POST" class="bg-surface border border-line rounded-2xl p-6 md:p-8" novalidate>
          <div class="grid gap-4">
            <div>
              <label for={id + "-name"} class="block text-sm font-medium text-ink mb-1.5">Your name</label>
              <input id={id + "-name"} name="name" type="text" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition" placeholder="Your name" />
              <p id={id + "-name-err"} class="text-sm text-ink mt-1 hidden">Please enter your name.</p>
            </div>
            <div>
              <label for={id + "-school"} class="block text-sm font-medium text-ink mb-1.5">School name</label>
              <input id={id + "-school"} name="school" type="text" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition" placeholder="School name" />
              <p id={id + "-school-err"} class="text-sm text-ink mt-1 hidden">Please enter your school name.</p>
            </div>
            <div>
              <label for={id + "-whatsapp"} class="block text-sm font-medium text-ink mb-1.5">WhatsApp number</label>
              <input id={id + "-whatsapp"} name="whatsapp" type="tel" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition" placeholder="07XX XXX XXX" inputmode="numeric" />
              <p id={id + "-whatsapp-err"} class="text-sm text-ink mt-1 hidden">Please enter a valid WhatsApp number.</p>
            </div>
            <div>
              <label for={id + "-role"} class="block text-sm font-medium text-ink mb-1.5">Role</label>
              <select id={id + "-role"} name="role" required class="w-full border border-line rounded-lg px-4 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 transition appearance-none">
                <option value="" disabled selected>Select your role</option>
                <option value="Headteacher">Headteacher</option>
                <option value="Deputy">Deputy headteacher</option>
                <option value="Bursar">Bursar</option>
                <option value="Owner">School owner</option>
                <option value="Other">Other</option>
              </select>
              <p id={id + "-role-err"} class="text-sm text-ink mt-1 hidden">Please select your role.</p>
            </div>
            <div aria-hidden="true" class="hidden">
              <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
            </div>
          </div>
          <button type="submit" id={id + "-btn"} class="w-full mt-5 bg-ink text-white font-semibold rounded-lg px-6 py-4 text-base hover:bg-neutral-800 transition-colors min-h-[48px]">Join the pilot</button>
          <div id={id + "-status"} class="mt-4 text-sm" aria-live="polite"></div>
        </form>
        <a href="https://wa.me/[WHATSAPP_NUMBER_INTERNATIONAL_FORMAT]?text=Hi%2C%20I'd%20like%20to%20join%20the%20Somotracker%20pilot." class="inline-flex mt-4 w-full justify-center border border-ink text-ink font-semibold rounded-lg px-6 py-4 hover:bg-ink hover:text-white transition-colors text-base" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('form[data-form-id]').forEach(function (form) {
      const id = form.getAttribute('data-form-id');
      const btn = document.getElementById(id + '-btn') as HTMLButtonElement | null;
      if (!btn || !id) return;
      form.addEventListener('submit', function (e) {
        const fields = ['name', 'school', 'whatsapp', 'role'];
        let valid = true;
        fields.forEach(function (key) {
          const el = document.getElementById(id + '-' + key) as HTMLInputElement | HTMLSelectElement | null;
          const err = document.getElementById(id + '-' + key + '-err');
          if (el && err) {
            if (!el.value.trim()) {
              err.classList.remove('hidden');
              valid = false;
            } else {
              err.classList.add('hidden');
            }
          }
        });
        if (!valid) {
          e.preventDefault();
          return;
        }
        const hp = form.querySelector('input[name="honeypot"]') as HTMLInputElement | null;
        if (hp && hp.value.trim() !== '') {
          e.preventDefault();
          return;
        }
        btn.textContent = 'Sending...';
        btn.disabled = true;
        btn.classList.add('opacity-70');
        const endpoint = form.getAttribute('action');
        if (!endpoint || endpoint.startsWith('[')) {
          e.preventDefault();
          form.innerHTML = '<div class="p-6"><p class="text-lg font-semibold text-ink">Karibu. We\'ve got your details and will WhatsApp you within 48 hours.</p></div>';
          return;
        }
      });
    });
  })();
</script>
