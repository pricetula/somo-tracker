---
interface Props {
  title?: string;
  subtitle?: string;
}
const { title = "Fast, static marketing site powered by Astro", subtitle = "Build beautiful, fast marketing pages with zero-JS by default. Add interactivity only where you need it." } = Astro.props;
---
<section class="relative">
  <div class="mx-auto max-w-6xl px-6 py-24 text-center">
    <h1 class="text-5xl font-bold tracking-tight">{title}</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">{subtitle}</p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/pricing" class="rounded-md bg-slate-900 px-6 py-3 font-medium text-white hover:bg-slate-800">View pricing</a>
      <a href="/about" class="rounded-md border px-6 py-3 font-medium hover:bg-slate-50">Learn more</a>
    </div>
  </div>
</section>
