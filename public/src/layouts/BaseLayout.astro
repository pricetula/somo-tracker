---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'Somotracker' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta name="description" content="Somotracker marketing site" />
  </head>
  <body>
    <slot />
  </body>
</html>
