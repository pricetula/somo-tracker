---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/marketing/Navbar.astro';
import Hero from '../components/marketing/Hero.astro';
import CTA from '../components/marketing/CTA.astro';
import Footer from '../components/marketing/Footer.astro';
export const prerender = true;
---
<BaseLayout title="Somotracker — Marketing">
  <Navbar />
  <main class="min-h-screen">
    <Hero title="Somotracker" subtitle="Fast, static marketing site powered by Astro." />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
