---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FeatureCards from '../components/FeatureCards.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Roadmap from '../components/Roadmap.astro';
import Founder from '../components/Founder.astro';
import PilotForm from '../components/PilotForm.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />
  <main>
    <Hero />
    <TrustStrip />
    <FeatureCards />
    <BeforeAfter />
    <Roadmap />
    <Founder />
    <PilotForm id="join" />
    <FAQ />
  </main>
  <Footer />
</Layout>
