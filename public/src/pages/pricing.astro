---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/marketing/Navbar.astro';
import Footer from '../components/marketing/Footer.astro';
export const prerender = true;
---
<BaseLayout title="Pricing — Somotracker">
  <Navbar />
  <main class="mx-auto max-w-6xl px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight">Pricing</h1>
    <p class="mt-4 text-slate-600">Simple, transparent plans for teams of all sizes.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <div class="rounded-xl border p-6">
        <h2 class="text-xl font-semibold">Starter</h2>
        <p class="mt-2 text-3xl font-bold">$0</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-600">
          <li>Up to 3 users</li>
          <li>Basic tracking</li>
        </ul>
      </div>
      <div class="rounded-xl border p-6">
        <h2 class="text-xl font-semibold">Pro</h2>
        <p class="mt-2 text-3xl font-bold">$29/mo</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-600">
          <li>Unlimited users</li>
          <li>Advanced analytics</li>
        </ul>
      </div>
      <div class="rounded-xl border p-6">
        <h2 class="text-xl font-semibold">Enterprise</h2>
        <p class="mt-2 text-3xl font-bold">Contact us</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-600">
          <li>Custom contracts</li>
          <li>Dedicated support</li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
